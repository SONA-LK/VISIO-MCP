{
  "name": "visiomcp",
  "version": "0.1.0",
  "description": "MCP server for controlling Microsoft Visio via Windows COM automation",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest --testPathPattern=tests/unit",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:all": "jest",
    "clean": "rimraf dist dist-test",
    "package": "npm run build && pkg dist/index.js --targets node18-win-x64 --output VisioMCP.exe --config pkg.config.json",
    "lint": "tsc --noEmit"
  },
  "keywords": ["mcp", "visio", "automation", "windows", "com"],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "winax": "^3.1.4",
    "zod": "^3.22.4",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/jest": "^29.5.11",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3",
    "rimraf": "^5.0.5",
    "pkg": "^5.8.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "os": ["win32"]
}
