{
  "name": "visiomcp",
  "version": "0.2.0",
  "description": "MCP server for controlling Microsoft Visio via Windows COM automation",
  "main": "dist/index.js",
  "bin": {
    "visiomcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest --testPathPattern=tests/unit",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:all": "jest",
    "clean": "rimraf dist dist-test",
    "prepublishOnly": "npm run build",
    "lint": "tsc --noEmit"
  },
  "keywords": ["mcp", "visio", "automation", "windows", "com"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SONA-LK/VISIO-MCP.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "winax": "^3.1.4",
    "zod": "^3.22.4",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/jest": "^29.5.11",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3",
    "rimraf": "^5.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "os": ["win32"]
}
